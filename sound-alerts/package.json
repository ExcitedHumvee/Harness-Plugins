{
  "name": "dsh-sound-alerts",
  "version": "0.2.0",
  "private": true,
  "description": "Notification sounds for the DSH Web GUI: a cue when a final response completes and another when the agent is waiting on you, with a header control for customizing both",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExcitedHumvee/Harness-Plugins.git",
    "directory": "sound-alerts"
  },
  "license": "MIT"
}
