{
  "name": "dsh-stt",
  "version": "0.1.0",
  "private": true,
  "description": "Speech to text for the DSH Web GUI composer, backed by a local faster-whisper sidecar",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
