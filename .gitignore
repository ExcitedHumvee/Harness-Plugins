# Node
node_modules/

# Pre-patch copies of the published frontend bundle and shell files. These are
# proprietary build artifacts, recreated by the rebrand on first run, so they must
# never be committed. They live beside the host plugin that writes them.
rebrand/lib/backups/
*.orig-backup

# The space-free directory links `install.mjs` creates when the checkout path
# contains a space, which DSH cannot forward to pnpm on Windows.
.dsh-plugin-links/

# OS and editor noise
.DS_Store
Thumbs.db
desktop.ini
